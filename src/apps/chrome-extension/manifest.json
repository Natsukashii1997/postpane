{
  "manifest_version": 3,
  "name": "驿窗 · ChatGPT 接力",
  "version": "0.2.13",
  "description": "把驿窗接力里的 ChatGPT 会话接进驿窗：只读、只报驿窗名单里的会话。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["nativeMessaging", "scripting", "storage", "tabGroups"],
  "host_permissions": ["https://chatgpt.com/*"]
}
